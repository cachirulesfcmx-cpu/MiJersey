// Dominio Identity — ver docs/prompts/003-Authentication-Authorization.md.
// Los siguientes módulos de dominio agregarán sus propios modelos aquí.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SUPPORT
  CUSTOMER

  @@map("role_name")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("session_status")
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  passwordHash       String
  firstName          String
  lastName           String
  roleId             String
  role               Role                     @relation(fields: [roleId], references: [id])
  emailVerifiedAt    DateTime?
  isActive           Boolean                  @default(true)
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  auditLogs          AuditLog[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([roleId])
  @@map("users")
}

model Session {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String        @unique
  userAgent        String?
  ipAddress        String?
  status           SessionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  lastUsedAt       DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// Dominio Catalog — ver docs/prompts/005-Product-Catalog.md.

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum ProductVisibility {
  PUBLIC
  HIDDEN

  @@map("product_visibility")
}

enum ProductType {
  PHYSICAL
  DIGITAL

  @@map("product_type")
}

model Product {
  id                String              @id @default(uuid())
  sku               String              @unique
  slug              String              @unique
  name              String
  shortDescription  String?
  description       String?
  status            ProductStatus       @default(DRAFT)
  visibility        ProductVisibility   @default(HIDDEN)
  type              ProductType         @default(PHYSICAL)
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  categories        ProductCategory[]
  collections       CollectionProduct[]
  options           ProductOption[]
  variants          ProductVariant[]

  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@map("products")
}

// Variantes de producto — ver docs/prompts/007-Product-Variants.md.

model ProductOption {
  id        String               @id @default(uuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    ProductOptionValue[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id        String                      @id @default(uuid())
  optionId  String
  option    ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     String
  position  Int                         @default(0)
  variants  ProductVariantOptionValue[]
  createdAt DateTime                    @default(now())

  @@unique([optionId, value])
  @@index([optionId])
  @@map("product_option_values")
}

enum ProductVariantStatus {
  ACTIVE
  ARCHIVED

  @@map("product_variant_status")
}

model ProductVariant {
  id             String                      @id @default(uuid())
  productId      String
  product        Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String                      @unique
  barcode        String?
  slug           String                      @unique
  title          String
  price          Decimal                     @db.Decimal(10, 2)
  compareAtPrice Decimal?                    @db.Decimal(10, 2)
  weight         Float?
  imageId        String?
  status         ProductVariantStatus        @default(ACTIVE)
  /// Combinación normalizada (optionValueIds ordenados y unidos) — garantiza combinaciones únicas por producto.
  combinationKey String
  optionValues   ProductVariantOptionValue[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([productId, combinationKey])
  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("product_variant_option_values")
}

// Dominio Taxonomy (categorías y colecciones) — ver docs/prompts/006-Categories-Collections.md.

enum CategoryStatus {
  ACTIVE
  HIDDEN

  @@map("category_status")
}

enum CollectionStatus {
  ACTIVE
  HIDDEN

  @@map("collection_status")
}

enum CollectionType {
  MANUAL
  SMART

  @@map("collection_type")
}

enum CollectionRuleField {
  NAME
  SKU
  TYPE
  STATUS

  @@map("collection_rule_field")
}

enum CollectionRuleOperator {
  EQUALS
  CONTAINS

  @@map("collection_rule_operator")
}

enum CollectionRuleMatchType {
  ALL
  ANY

  @@map("collection_rule_match_type")
}

model Category {
  id          String         @id @default(uuid())
  parentId    String?
  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]     @relation("CategoryHierarchy")
  slug        String         @unique
  name        String
  description String?
  image       String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  products    ProductCategory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model ProductCategory {
  productId  String
  categoryId String
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Collection {
  id          String                   @id @default(uuid())
  slug        String                   @unique
  name        String
  description String?
  type        CollectionType
  status      CollectionStatus         @default(ACTIVE)
  matchType   CollectionRuleMatchType  @default(ALL)
  rules       CollectionRule[]
  products    CollectionProduct[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([status])
  @@map("collections")
}

model CollectionRule {
  id           String                 @id @default(uuid())
  collectionId String
  collection   Collection             @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  field        CollectionRuleField
  operator     CollectionRuleOperator
  value        String
  createdAt    DateTime               @default(now())

  @@index([collectionId])
  @@map("collection_rules")
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}
