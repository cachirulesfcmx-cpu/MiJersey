// Dominio Identity — ver docs/prompts/003-Authentication-Authorization.md.
// Los siguientes módulos de dominio agregarán sus propios modelos aquí.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SUPPORT
  CUSTOMER

  @@map("role_name")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("session_status")
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  passwordHash       String
  firstName          String
  lastName           String
  roleId             String
  role               Role                     @relation(fields: [roleId], references: [id])
  emailVerifiedAt    DateTime?
  isActive           Boolean                  @default(true)
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  auditLogs          AuditLog[]
  /// 019-Customer-Account: datos propios del área de cliente (teléfono, preferencias) — no duplica firstName/lastName, que siguen viviendo aquí y se editan vía PATCH /auth/profile (003), reutilizado por 019.
  customerProfile    CustomerProfile?
  addresses          Address[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([roleId])
  @@map("users")
}

model Session {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String        @unique
  userAgent        String?
  ipAddress        String?
  status           SessionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  lastUsedAt       DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// Dominio Catalog — ver docs/prompts/005-Product-Catalog.md.

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum ProductVisibility {
  PUBLIC
  HIDDEN

  @@map("product_visibility")
}

enum ProductType {
  PHYSICAL
  DIGITAL

  @@map("product_type")
}

model Product {
  id               String              @id @default(uuid())
  sku              String              @unique
  slug             String              @unique
  name             String
  shortDescription String?
  description      String?
  status           ProductStatus       @default(DRAFT)
  visibility       ProductVisibility   @default(HIDDEN)
  type             ProductType         @default(PHYSICAL)
  /// Propiedad exclusiva de Brands (011): un producto pertenece a una marca como máximo (spec §4).
  brandId          String?
  brand            Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  categories       ProductCategory[]
  collections      CollectionProduct[]
  options          ProductOption[]
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  media            ProductMedia[]

  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@index([brandId])
  @@map("products")
}

/// Galería ordenada de imágenes/video del producto (015). `mediaId` es un ID de MediaAsset (010) sin relación de Prisma hacia esa tabla a propósito — se consulta/registra uso vía MediaUsageService, mismo criterio que Brand.logoMediaId.
model ProductMedia {
  productId String
  mediaId   String
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([productId, mediaId])
  @@index([productId])
  @@map("product_media")
}

// Variantes de producto — ver docs/prompts/007-Product-Variants.md.

model ProductOption {
  id        String               @id @default(uuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    ProductOptionValue[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id        String                      @id @default(uuid())
  optionId  String
  option    ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     String
  position  Int                         @default(0)
  variants  ProductVariantOptionValue[]
  createdAt DateTime                    @default(now())

  @@unique([optionId, value])
  @@index([optionId])
  @@map("product_option_values")
}

enum ProductVariantStatus {
  ACTIVE
  ARCHIVED

  @@map("product_variant_status")
}

model ProductVariant {
  id             String                      @id @default(uuid())
  productId      String
  product        Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String                      @unique
  barcode        String?
  slug           String                      @unique
  title          String
  price          Decimal                     @db.Decimal(10, 2)
  compareAtPrice Decimal?                    @db.Decimal(10, 2)
  weight         Float?
  imageId        String?
  status         ProductVariantStatus        @default(ACTIVE)
  /// Combinación normalizada (optionValueIds ordenados y unidos) — garantiza combinaciones únicas por producto.
  combinationKey String
  optionValues   ProductVariantOptionValue[]
  inventoryItems InventoryItem[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([productId, combinationKey])
  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("product_variant_option_values")
}

// Dominio Taxonomy (categorías y colecciones) — ver docs/prompts/006-Categories-Collections.md.

enum CategoryStatus {
  ACTIVE
  HIDDEN

  @@map("category_status")
}

enum CollectionStatus {
  ACTIVE
  HIDDEN

  @@map("collection_status")
}

enum CollectionType {
  MANUAL
  SMART

  @@map("collection_type")
}

enum CollectionRuleField {
  NAME
  SKU
  TYPE
  STATUS

  @@map("collection_rule_field")
}

enum CollectionRuleOperator {
  EQUALS
  CONTAINS

  @@map("collection_rule_operator")
}

enum CollectionRuleMatchType {
  ALL
  ANY

  @@map("collection_rule_match_type")
}

model Category {
  id          String            @id @default(uuid())
  parentId    String?
  parent      Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]        @relation("CategoryHierarchy")
  slug        String            @unique
  name        String
  description String?
  image       String?
  sortOrder   Int               @default(0)
  status      CategoryStatus    @default(ACTIVE)
  products    ProductCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model ProductCategory {
  productId  String
  categoryId String
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Collection {
  id          String                  @id @default(uuid())
  slug        String                  @unique
  name        String
  description String?
  type        CollectionType
  status      CollectionStatus        @default(ACTIVE)
  matchType   CollectionRuleMatchType @default(ALL)
  rules       CollectionRule[]
  products    CollectionProduct[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status])
  @@map("collections")
}

model CollectionRule {
  id           String                 @id @default(uuid())
  collectionId String
  collection   Collection             @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  field        CollectionRuleField
  operator     CollectionRuleOperator
  value        String
  createdAt    DateTime               @default(now())

  @@index([collectionId])
  @@map("collection_rules")
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

// Atributos y filtros — ver docs/prompts/008-Attributes-Filters.md.

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  LIST
  COLOR
  MEASUREMENT

  @@map("attribute_type")
}

enum AttributeStatus {
  ACTIVE
  ARCHIVED

  @@map("attribute_status")
}

model Attribute {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  type         AttributeType
  isFilterable Boolean            @default(false)
  isComparable Boolean            @default(false)
  isRequired   Boolean            @default(false)
  sortOrder    Int                @default(0)
  status       AttributeStatus    @default(ACTIVE)
  /// Eliminación lógica (mismo patrón que Product.deletedAt en 005) — nunca se borra la fila.
  deletedAt    DateTime?
  values       AttributeValue[]
  assignments  ProductAttribute[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@map("attributes")
}

model AttributeValue {
  id          String             @id @default(uuid())
  attributeId String
  attribute   Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  label       String
  sortOrder   Int                @default(0)
  assignments ProductAttribute[]
  createdAt   DateTime           @default(now())

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttribute {
  id          String          @id @default(uuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueId     String?
  value       AttributeValue? @relation(fields: [valueId], references: [id], onDelete: Cascade)
  customValue String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([productId, attributeId])
  @@index([attributeId])
  @@index([valueId])
  @@map("product_attributes")
}

// Inventario — ver docs/prompts/009-Inventory.md.

enum WarehouseStatus {
  ACTIVE
  ARCHIVED

  @@map("warehouse_status")
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
  RESERVATION
  RELEASE
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  RETURN

  @@map("inventory_movement_type")
}

model Warehouse {
  id        String          @id @default(uuid())
  code      String          @unique
  name      String
  status    WarehouseStatus @default(ACTIVE)
  items     InventoryItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@map("warehouses")
}

model InventoryItem {
  id                String              @id @default(uuid())
  variantId         String
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouseId       String
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  availableQuantity Int                 @default(0)
  reservedQuantity  Int                 @default(0)
  incomingQuantity  Int                 @default(0)
  safetyStock       Int                 @default(0)
  /// Bloqueo optimista (spec §9) — se incrementa en cada escritura; las escrituras concurrentes con una versión obsoleta fallan.
  version           Int                 @default(0)
  movements         InventoryMovement[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String                @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  type            InventoryMovementType
  quantity        Int
  reason          String?
  referenceType   String?
  referenceId     String?
  createdBy       String
  createdAt       DateTime              @default(now())

  @@index([inventoryItemId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// Biblioteca de medios — ver docs/prompts/010-Media-Library.md.

enum MediaAssetStatus {
  ACTIVE
  ARCHIVED

  @@map("media_asset_status")
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT

  @@map("media_type")
}

model Folder {
  id        String       @id @default(uuid())
  parentId  String?
  parent    Folder?      @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children  Folder[]     @relation("FolderChildren")
  name      String
  slug      String       @unique
  assets    MediaAsset[]
  createdAt DateTime     @default(now())

  @@index([parentId])
  @@map("folders")
}

model AssetTag {
  id     String          @id @default(uuid())
  name   String          @unique
  slug   String          @unique
  assets MediaAssetTag[]

  @@map("asset_tags")
}

model MediaAsset {
  id           String            @id @default(uuid())
  /// Nombre generado internamente para el archivo almacenado (único por construcción).
  filename     String            @unique
  originalName String
  mimeType     String
  type         MediaType
  size         Int
  width        Int?
  height       Int?
  duration     Float?
  altText      String?
  title        String?
  status       MediaAssetStatus  @default(ACTIVE)
  /// SHA-256 del contenido — garantiza "no duplicar archivos idénticos" (spec §5).
  contentHash  String            @unique
  storageKey   String
  url          String
  thumbnailUrl String?
  folderId     String?
  folder       Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags         MediaAssetTag[]
  usages       MediaAssetUsage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([folderId])
  @@index([status])
  @@index([type])
  @@map("media_assets")
}

model MediaAssetTag {
  mediaAssetId String
  assetTagId   String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  assetTag     AssetTag   @relation(fields: [assetTagId], references: [id], onDelete: Cascade)

  @@id([mediaAssetId, assetTagId])
  @@index([assetTagId])
  @@map("media_asset_tags")
}

/// Referencia genérica de uso (spec §5 "mantener historial de uso" / "eliminar solo sin referencias") — mismo patrón que InventoryMovement.referenceType/referenceId.
model MediaAssetUsage {
  id            String     @id @default(uuid())
  mediaAssetId  String
  mediaAsset    MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  referenceType String
  referenceId   String
  createdAt     DateTime   @default(now())

  @@unique([mediaAssetId, referenceType, referenceId])
  @@index([mediaAssetId])
  @@index([referenceType, referenceId])
  @@map("media_asset_usages")
}

enum BrandStatus {
  ACTIVE
  ARCHIVED

  @@map("brand_status")
}

model Brand {
  id               String      @id @default(uuid())
  slug             String      @unique
  name             String      @unique
  description      String?
  shortDescription String?
  /// IDs de MediaAsset (010) — sin relación de Prisma a propósito: Brands consulta/registra uso vía MediaUsageService, no importa el módulo Media.
  logoMediaId      String?
  coverMediaId     String?
  website          String?
  country          String?
  status           BrandStatus @default(ACTIVE)
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  products         Product[]

  @@index([status])
  @@map("brands")
}

enum SeoEntityType {
  PRODUCT
  CATEGORY
  COLLECTION
  BRAND

  @@map("seo_entity_type")
}

enum SeoRobotsDirective {
  INDEX_FOLLOW
  NOINDEX_FOLLOW
  INDEX_NOFOLLOW
  NOINDEX_NOFOLLOW

  @@map("seo_robots_directive")
}

enum SeoTwitterCardType {
  SUMMARY
  SUMMARY_LARGE_IMAGE

  @@map("seo_twitter_card_type")
}

/// Metadatos SEO por entidad — spec §4 "cada entidad tendrá como máximo un registro SEO".
model SeoMetadata {
  id              String             @id @default(uuid())
  entityType      SeoEntityType
  entityId        String
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  canonicalUrl    String?
  robots          SeoRobotsDirective @default(INDEX_FOLLOW)
  ogTitle         String?
  ogDescription   String?
  /// ID de MediaAsset (010) — sin relación de Prisma a propósito, mismo criterio que Brand.logoMediaId.
  ogImageMediaId  String?
  twitterCard     SeoTwitterCardType @default(SUMMARY_LARGE_IMAGE)
  structuredData  Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([entityType, entityId])
  @@map("seo_metadata")
}

/// Redirecciones permanentes — spec §4 "redirecciones permanentes cuando cambie un slug".
model Redirect {
  id         String   @id @default(uuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())

  @@map("redirects")
}

enum HomeSectionType {
  HERO_BANNER
  BANNER_GRID
  FEATURED_PRODUCTS
  FEATURED_CATEGORIES
  FEATURED_COLLECTIONS
  FEATURED_BRANDS
  PROMOTION_BANNER
  RICH_TEXT
  IMAGE_TEXT
  VIDEO_BANNER
  NEWSLETTER

  @@map("home_section_type")
}

enum HomeSectionStatus {
  DRAFT
  PUBLISHED

  @@map("home_section_status")
}

/// Bloque configurable de la Home (013) — reordenable, activable/desactivable. `configuration` es JSON libre cuya forma depende de `type` (ver domain/value-objects/home-section-config.ts).
model HomeSection {
  id            String            @id @default(uuid())
  type          HomeSectionType
  title         String
  configuration Json
  sortOrder     Int               @default(0)
  status        HomeSectionStatus @default(DRAFT)
  /// Interruptor rápido independiente de `status` — spec §5 "visibility": permite ocultar temporalmente una sección publicada sin perder su configuración ni volver a borrador.
  isVisible     Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, isVisible, sortOrder])
  @@map("home_sections")
}

enum SearchResultType {
  PRODUCT
  CATEGORY
  BRAND
  COLLECTION

  @@map("search_result_type")
}

/// Registro de cada búsqueda ejecutada (016) — base de "historial"/"trending"/"sin resultados". `sessionId` es un id anónimo generado por el storefront (no existe todavía un concepto de sesión de invitado a nivel de backend).
model SearchQueryLog {
  id             String   @id @default(uuid())
  term           String
  normalizedTerm String
  resultsCount   Int
  sessionId      String?
  customerId     String?
  createdAt      DateTime @default(now())

  @@index([normalizedTerm])
  @@index([createdAt])
  @@index([resultsCount])
  @@map("search_query_logs")
}

/// Clic sobre un resultado de búsqueda (016) — insumo mínimo de conversión; el embudo completo (compra posterior) llega con 032-Analytics.
model SearchClickLog {
  id         String           @id @default(uuid())
  term       String
  entityType SearchResultType
  entityId   String
  sessionId  String?
  createdAt  DateTime         @default(now())

  @@index([term])
  @@map("search_click_logs")
}

/// Grupo de sinónimos (016): buscar por cualquier término del grupo expande la consulta a todos los demás. Sin relación hacia Attributes/Catalog — es un concepto propio del motor de búsqueda.
model SearchSynonym {
  id        String   @id @default(uuid())
  term      String   @unique
  synonyms  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("search_synonyms")
}

enum CartStatus {
  ACTIVE
  MERGED
  ABANDONED
  CONVERTED

  @@map("cart_status")
}

enum CouponType {
  PERCENTAGE
  FIXED

  @@map("coupon_type")
}

/// Carrito (017) — uno por sesión anónima (`sessionId`, generado por el storefront) y opcionalmente ligado a un cliente (`customerId`) tras iniciar sesión/fusionar. `couponCode` referencia a `Coupon.code`; el descuento se recalcula en caliente contra el subtotal vigente, nunca se guarda un monto fijo.
model Cart {
  id         String     @id @default(uuid())
  customerId String?
  sessionId  String
  currency   String     @default("MXN")
  status     CartStatus @default(ACTIVE)
  couponCode String?
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([sessionId])
  @@index([customerId])
  @@index([status])
  @@map("carts")
}

/// `unitPrice` es una foto del precio de la variante al momento de agregarla/actualizar cantidad — no se re-sincroniza silenciosamente en cada lectura (esa revalidación completa es responsabilidad de 018-Checkout antes de confirmar el pedido).
model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  variantId String
  sku       String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

/// Cupón mínimo, propio de Cart (017) — un motor de promociones completo (reglas, apilamiento, programación, límites de uso) es responsabilidad de 024-Coupons-Promotions. `value` se interpreta según `type`: porcentaje (0-100) o monto fijo en la moneda del carrito.
model Coupon {
  id        String     @id @default(uuid())
  code      String     @unique
  type      CouponType
  value     Decimal    @db.Decimal(10, 2)
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("coupons")
}

enum CheckoutStatus {
  STARTED
  CONFIRMED
  ABANDONED

  @@map("checkout_status")
}

/// 021-Orders (§4) enumera 8 estados (Pending, Confirmed, Paid, Processing, Shipped, Delivered, Cancelled, Refunded) sin decir en cuál de los tres campos mínimos (`status`, `paymentStatus`, `fulfillmentStatus`) va cada uno. Se repartieron sin ambigüedad: `OrderStatus` es el estado general del pedido (ciclo de vida de alto nivel), `PaymentStatus` el estado del cobro y `FulfillmentStatus` el del cumplimiento — cada uno de los 8 nombres aparece en exactamente un enum.
enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED

  @@map("fulfillment_status")
}

/// Dirección propia de Checkout (018): una foto de captura, no una libreta de direcciones reutilizable. 019-Customer-Account definirá su propio `Address` (con `customerId`, `type`, `isDefault`) para guardar direcciones entre compras; hasta entonces, cada checkout —incluido el de invitados, que no tienen cuenta— captura la suya desde cero. Referenciada tanto por `CheckoutSession` (mientras se arma el pedido) como por `Order` (foto congelada al confirmar).
model CheckoutAddress {
  id                     String            @id @default(uuid())
  firstName              String
  lastName               String
  company                String?
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String
  postalCode             String
  country                String
  phone                  String?
  createdAt              DateTime          @default(now())
  checkoutSessionsShipTo CheckoutSession[] @relation("CheckoutSessionShippingAddress")
  checkoutSessionsBillTo CheckoutSession[] @relation("CheckoutSessionBillingAddress")
  ordersShipTo           Order[]           @relation("OrderShippingAddress")
  ordersBillTo           Order[]           @relation("OrderBillingAddress")

  @@map("checkout_addresses")
}

/// Método de envío mínimo, propio de Checkout (018): tarifa plana editable en el admin, sin transportistas, zonas de cobertura ni motor de cálculo por peso/dimensiones — eso es 023-Shipping. `estimatedDaysMin/Max` alimenta el mensaje "llega en X-Y días" sin prometer una fecha exacta.
model ShippingMethod {
  id               String            @id @default(uuid())
  name             String
  description      String?
  basePrice        Decimal           @db.Decimal(10, 2)
  estimatedDaysMin Int
  estimatedDaysMax Int
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  checkoutSessions CheckoutSession[]
  orders           Order[]

  @@map("shipping_methods")
}

/// Sesión de checkout (018): una por carrito activo (`cartId` único — "mantener una única sesión activa por carrito", spec §5). Igual que Cart, soporta invitados (`sessionId`) y clientes (`customerId`). No guarda totales: se recalculan en caliente contra el carrito vigente hasta el momento de `POST /checkout/confirm`, que los congela en `Order`.
model CheckoutSession {
  id                String           @id @default(uuid())
  cartId            String           @unique
  customerId        String?
  sessionId         String
  contactEmail      String?
  shippingAddressId String?
  shippingAddress   CheckoutAddress? @relation("CheckoutSessionShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String?
  billingAddress    CheckoutAddress? @relation("CheckoutSessionBillingAddress", fields: [billingAddressId], references: [id])
  shippingMethodId  String?
  shippingMethod    ShippingMethod?  @relation(fields: [shippingMethodId], references: [id])
  status            CheckoutStatus   @default(STARTED)
  orderId           String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([sessionId])
  @@index([customerId])
  @@map("checkout_sessions")
}

/// Modelo mínimo de 021-Orders, creado ahora porque el criterio de aceptación de 018-Checkout exige "generar una orden lista para pago" y su Definition of Done exige integrarse con 021 sin cambios estructurales. El ciclo de vida completo (máquina de estados con transiciones validadas, cancelaciones, reembolsos, devoluciones, timeline, endpoints de historial/reorden) es responsabilidad de 021; esta tabla ya tiene la forma exacta de su modelo mínimo. Los totales aquí sí son definitivos (a diferencia de Cart/CheckoutSession, que los recalculan en caliente) porque representan lo que se le va a cobrar al cliente.
model Order {
  id                String            @id @default(uuid())
  orderNumber       String            @unique
  customerId        String?
  contactEmail      String
  status            OrderStatus       @default(CONFIRMED)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String
  subtotal          Decimal           @db.Decimal(10, 2)
  discountTotal     Decimal           @db.Decimal(10, 2)
  shippingTotal     Decimal           @db.Decimal(10, 2)
  taxTotal          Decimal           @db.Decimal(10, 2)
  grandTotal        Decimal           @db.Decimal(10, 2)
  couponCode        String?
  shippingAddressId String?
  shippingAddress   CheckoutAddress?  @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String?
  billingAddress    CheckoutAddress?  @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])
  shippingMethodId  String?
  shippingMethod    ShippingMethod?   @relation(fields: [shippingMethodId], references: [id])
  items             OrderItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([customerId])
  @@index([contactEmail])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  variantId String
  sku       String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

/// 019-Customer-Account (§4). Solo los campos que `User` (003) no tiene ya — `firstName`/`lastName` siguen siendo de Identity, editables vía `PATCH /auth/profile`, reutilizado por `PATCH /me`. Se crea de forma perezosa (upsert) en el primer `GET /me`/`PATCH /me`, no en el registro — evita tocar el flujo de registro de 003 por un campo que puede quedar vacío indefinidamente.
model CustomerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?
  /// Sin esquema fijo todavía — spec §4 solo nombra el campo, sin definir su forma. Se usa como stand-in mínimo: `{ marketingEmailsOptIn: boolean }`.
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customer_profiles")
}

enum AddressType {
  SHIPPING
  BILLING

  @@map("address_type")
}

/// Libreta de direcciones reutilizable del cliente (019) — distinta de `CheckoutAddress` (018), que es una foto de captura sin dueño ligada a una sesión de checkout puntual. 018 anticipó esta tabla en su propio comentario; no existe integración entre ambas todavía (copiar una dirección guardada al checkout) porque ningún spec la exige aún — queda como mejora futura, no alcance de 019.
model Address {
  id           String      @id @default(uuid())
  customerId   String
  customer     User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         AddressType
  firstName    String
  lastName     String
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  phone        String?
  /// Una dirección predeterminada por tipo (spec §5) — se aplica en el caso de uso, no con una constraint de base de datos (mismo criterio que "una sesión de checkout activa por carrito" en 018).
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([customerId])
  @@map("addresses")
}
