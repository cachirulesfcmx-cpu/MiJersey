NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mijersey:mijersey@localhost:5432/mijersey?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info
JWT_ACCESS_SECRET=change-this-to-a-random-string-of-at-least-32-characters
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:4000

# Carpeta local donde se guardan los archivos subidos a la Media Library (010).
MEDIA_UPLOADS_DIR=uploads

# Opcionales: si se definen ambos, `pnpm prisma:seed` crea un usuario Super Admin.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
