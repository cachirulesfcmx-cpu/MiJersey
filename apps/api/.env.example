NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mijersey:mijersey@localhost:5432/mijersey?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info
JWT_ACCESS_SECRET=change-this-to-a-random-string-of-at-least-32-characters
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:4000

# Carpeta local donde se guardan los archivos subidos a la Media Library (010).
MEDIA_UPLOADS_DIR=uploads

# Almacenamiento de Media Library: "local" (disco del contenedor, no sobrevive un redeploy)
# o "r2" (Cloudflare R2). Con "r2", las 5 variables R2_* son obligatorias.
STORAGE_DRIVER=local
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Opcionales: si se definen ambos, `pnpm prisma:seed` crea un usuario Super Admin.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Opcionales: SMTP para envío real de correos (031). Sin SMTP_HOST, los correos
# se registran en el log en vez de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MiJersey <no-reply@mijersey.com>
